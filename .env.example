# Postgres connection string.
# Matches docker-compose.yml as-is. Point it at any Postgres (Neon, Supabase, local) instead.
DATABASE_URL="postgresql://folio:folio@localhost:5433/folio?schema=public"

# Unpooled connection, used only by migrations.
# Locally this is the same server. On a pooled host such as Neon, use the direct endpoint.
DIRECT_URL="postgresql://folio:folio@localhost:5433/folio?schema=public"

# Signs session cookies. Any long random string works locally.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="dev-only-secret-change-me"

# Blob storage token, used for document attachments.
# Optional: leave empty and attachment uploads are disabled. Everything else still works.
BLOB_READ_WRITE_TOKEN=""
